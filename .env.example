# Configure these in Netlify Site configuration > Environment variables.
# Never commit real credentials.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Netlify sets URL automatically for deployed sites; set explicitly only if needed.
URL=https://xbihub.com
# Optional production integrations to be added after provider selection:
# RESEND_API_KEY=
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_PRIVATE_KEY=
MAIL_FROM=XBIHUB <verified-sender@your-domain.com>\n